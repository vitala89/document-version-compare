{
  "id": "doc-team-handbook",
  "version": 3,
  "title": "Team Handbook",
  "updatedAt": "2026-09-18",
  "children": [
    {
      "id": "sec-intro",
      "type": "section",
      "title": "Introduction",
      "children": [
        {
          "id": "cl-intro-purpose",
          "type": "clause",
          "title": "Purpose",
          "children": [
            {
              "id": "p-intro-purpose-1",
              "type": "paragraph",
              "text": "This handbook describes how the team works together. It applies to everyone on the team, including contractors and interns."
            }
          ]
        },
        {
          "id": "cl-intro-scope",
          "type": "clause",
          "title": "Scope",
          "children": [
            {
              "id": "p-intro-scope-1",
              "type": "paragraph",
              "text": "The handbook covers working hours, leave, expenses, security, approved tools and communication. It does not cover individual employment contracts."
            }
          ]
        },
        {
          "id": "cl-intro-control",
          "type": "clause",
          "title": "Document control",
          "children": [
            {
              "id": "f-intro-owner",
              "type": "field",
              "label": "Owner",
              "value": "Operations team"
            },
            {
              "id": "f-intro-cycle",
              "type": "field",
              "label": "Review cycle",
              "value": "Every 6 months"
            },
            {
              "id": "f-intro-reviewed",
              "type": "field",
              "label": "Last reviewed",
              "value": "02.04.2026"
            }
          ]
        }
      ]
    },
    {
      "id": "sec-hours",
      "type": "section",
      "title": "Working Time",
      "children": [
        {
          "id": "cl-hours-core",
          "type": "clause",
          "title": "Core hours",
          "children": [
            {
              "id": "f-hours-start",
              "type": "field",
              "label": "Core hours start",
              "value": "10:00"
            },
            {
              "id": "f-hours-end",
              "type": "field",
              "label": "Core hours end",
              "value": "15:00"
            },
            {
              "id": "p-hours-core-1",
              "type": "paragraph",
              "text": "Everyone is expected to be available during core hours in their local time zone. Meetings that need the whole team are scheduled inside this window."
            }
          ]
        },
        {
          "id": "cl-hours-flex",
          "type": "clause",
          "title": "Flexible time",
          "children": [
            {
              "id": "p-hours-flex-1",
              "type": "paragraph",
              "text": "Outside core hours you can arrange your day as you see fit, as long as you deliver what you committed to and keep your calendar up to date."
            }
          ]
        },
        {
          "id": "cl-hours-overtime",
          "type": "clause",
          "title": "Overtime",
          "children": [
            {
              "id": "f-hours-overtime-max",
              "type": "field",
              "label": "Maximum weekly overtime (hours)",
              "value": "8"
            },
            {
              "id": "p-hours-overtime-1",
              "type": "paragraph",
              "text": "Overtime is the exception, not the rule. Recurring overtime is a planning problem and should be raised with your lead."
            }
          ]
        }
      ]
    },
    {
      "id": "sec-leave",
      "type": "section",
      "title": "Leave",
      "children": [
        {
          "id": "cl-leave-annual",
          "type": "clause",
          "title": "Annual leave",
          "children": [
            {
              "id": "f-leave-annual-days",
              "type": "field",
              "label": "Days per year",
              "value": "27"
            },
            {
              "id": "p-leave-annual-1",
              "type": "paragraph",
              "text": "Request leave at least two weeks in advance for absences longer than three days. Shorter absences need one week's notice."
            }
          ]
        },
        {
          "id": "cl-hours-holidays",
          "type": "clause",
          "title": "Public holidays",
          "children": [
            {
              "id": "p-hours-holidays-1",
              "type": "paragraph",
              "text": "Public holidays follow the country where you are employed. Add them to the shared calendar at the start of each year."
            }
          ]
        },
        {
          "id": "cl-leave-sick",
          "type": "clause",
          "title": "Sick leave",
          "children": [
            {
              "id": "p-leave-sick-1",
              "type": "paragraph",
              "text": "If you are unwell, let your lead know before the start of your working day.  A medical certificate is required from the fourth consecutive day. "
            }
          ]
        },
        {
          "id": "cl-leave-parental",
          "type": "clause",
          "title": "Parental leave",
          "children": [
            {
              "id": "f-leave-parental-weeks",
              "type": "field",
              "label": "Paid weeks",
              "value": "16"
            },
            {
              "id": "p-leave-parental-1",
              "type": "paragraph",
              "text": "Parental leave can be taken in one block or split into two periods within the first year."
            }
          ]
        },
        {
          "id": "cl-leave-unpaid",
          "type": "clause",
          "title": "Unpaid leave",
          "children": [
            {
              "id": "p-leave-unpaid-1",
              "type": "paragraph",
              "text": "Unpaid leave of up to three months may be granted once every two years, subject to team capacity."
            }
          ]
        }
      ]
    },
    {
      "id": "sec-expenses",
      "type": "section",
      "title": "Expenses",
      "children": [
        {
          "id": "sec-travel",
          "type": "section",
          "title": "Travel",
          "children": [
            {
              "id": "cl-travel-flights",
              "type": "clause",
              "title": "Flights",
              "children": [
                {
                  "id": "p-travel-flights-1",
                  "type": "paragraph",
                  "text": "Book economy class for flights under eight hours. Premium economy may be booked for longer flights with prior approval."
                }
              ]
            },
            {
              "id": "cl-travel-hotels",
              "type": "clause",
              "title": "Hotels",
              "children": [
                {
                  "id": "f-travel-hotel-limit",
                  "type": "field",
                  "label": "Limit per night",
                  "value": "170 EUR"
                },
                {
                  "id": "p-travel-hotels-1",
                  "type": "paragraph",
                  "text": "Choose hotels close to the meeting location. Exceeding the limit requires written approval before booking."
                }
              ]
            },
            {
              "id": "cl-travel-perdiem",
              "type": "clause",
              "title": "Per diem",
              "children": [
                {
                  "id": "f-travel-perdiem",
                  "type": "field",
                  "label": "Daily allowance",
                  "value": "45 EUR"
                }
              ]
            }
          ]
        },
        {
          "id": "cl-exp-equipment",
          "type": "clause",
          "title": "Equipment purchases",
          "children": [
            {
              "id": "f-exp-equipment-limit",
              "type": "field",
              "label": "Limit without approval",
              "value": "1000 EUR"
            },
            {
              "id": "p-exp-equipment-1",
              "type": "paragraph",
              "text": "Purchases above the limit need approval from your lead and must be registered in the asset inventory."
            }
          ]
        },
        {
          "id": "cl-exp-reimbursement",
          "type": "clause",
          "title": "Reimbursement",
          "children": [
            {
              "id": "p-exp-reimbursement-1",
              "type": "paragraph",
              "text": "Submit receipts within <b>30 days</b> of the expense through the <a href=\"https://intranet.example.com/expenses\">expenses portal</a>. Late submissions may be rejected.<img src=\"x\" onerror=\"console.log('unsafe render')\">"
            }
          ]
        },
        {
          "id": "cl-exp-approval",
          "type": "clause",
          "title": "Approval",
          "children": [
            {
              "id": "f-exp-approver",
              "type": "field",
              "label": "Approver",
              "value": "Team lead"
            }
          ]
        }
      ]
    },
    {
      "id": "sec-security",
      "type": "section",
      "title": "Security",
      "children": [
        {
          "id": "cl-sec-credentials",
          "type": "clause",
          "title": "Credentials",
          "children": [
            {
              "id": "p-sec-credentials-1",
              "type": "paragraph",
              "text": "Use the company password manager for all work accounts. Passwords must be unique per service and at least 16 characters long. Enable two-factor authentication wherever it is available."
            }
          ]
        },
        {
          "id": "cl-sec-devices",
          "type": "clause",
          "title": "Devices",
          "children": [
            {
              "id": "p-sec-devices-1",
              "type": "paragraph",
              "text": "Work devices must have disk encryption and automatic screen lock enabled. Do not install software from unknown sources."
            }
          ]
        },
        {
          "id": "cl-sec-incidents",
          "type": "clause",
          "title": "Incident reporting",
          "children": [
            {
              "id": "f-sec-incident-contact",
              "type": "field",
              "label": "Report to",
              "value": "security@example.com"
            },
            {
              "id": "p-sec-incidents-1",
              "type": "paragraph",
              "text": "Report lost devices, suspected phishing and any unusual account activity immediately. There is no penalty for reporting a false alarm."
            }
          ]
        },
        {
          "id": "cl-sec-access",
          "type": "clause",
          "title": "Access reviews",
          "children": []
        }
      ]
    },
